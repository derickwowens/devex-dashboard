{
  "name": "federated-devex-platform",
  "version": "1.0.0",
  "description": "A federated developer experience platform demonstrating fluent facade patterns, centralized error handling, and AI-forward architecture",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspace=apps/dashboard",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "devex",
    "sdk",
    "facade",
    "federated",
    "ai-forward"
  ],
  "author": "Derick Owens",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
