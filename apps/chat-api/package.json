{
  "name": "@federated/chat-api",
  "version": "1.0.0",
  "description": "Chat API server with Anthropic integration for GitHub data queries",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run sync:knowledge && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "sync:knowledge": "node scripts/sync-knowledge.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
